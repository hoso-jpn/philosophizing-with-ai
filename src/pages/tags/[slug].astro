---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getPosts } from '../../lib/notion';
import { getSlugFromTag } from '../../lib/tag-slugs';
import type { Post } from '../../lib/types';
import FormattedDate from '../../components/FormattedDate.astro';

// タグページもビルド時に全件生成する。
// タグの一覧は記事から作るので、Notion 側でタグが増えてもコード変更は不要。
export async function getStaticPaths() {
  const allPosts = await getPosts();
  const tags = [...new Set(allPosts.flatMap((post) => post.tags))];

  return tags.map((tag) => ({
    // params にはデコード済みの値を渡す（URL エンコードは Astro が出力時に行う）。
    // 未登録タグの getSlugFromTag は encodeURIComponent 済みの文字列を返すため
    // （例: 労働 → %E5%8A%B4%E5%83%8D）、そのまま渡すと生成パスとの突き合わせに
    // 失敗して NoMatchingStaticPathFound になる。登録済みの ASCII slug は
    // デコードしても変わらないので、両方これで通る。
    params: { slug: decodeURIComponent(getSlugFromTag(tag)) },
    props: { tag, posts: allPosts.filter((post) => post.tags.includes(tag)) },
  }));
}

type Props = { tag: string; posts: Post[] };

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`${tag} の記事一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section style="max-width: 720px; margin: auto; padding: 1em;">
        <h1>{tag} の記事一覧</h1>
        <a href="/">← 全ての記事に戻る</a>
        <hr />
        {posts.length > 0 ? (
          <ul style="padding: 0;">
            {posts.map((post) => (
              <li style="margin-bottom: 2rem; list-style: none; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
                <div style="font-size: 0.9rem; color: var(--text-muted);"><FormattedDate date={post.date} /></div>
                <a href={`/posts/${post.slug || post.id}`} style="text-decoration: none;">
                  <h2 style="margin: 0; font-size: 1.4rem; color: var(--green-bright);">{post.title}</h2>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>このキーワードに該当する記事はありません。</p>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>
