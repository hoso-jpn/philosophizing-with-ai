---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeIntro from '../components/HomeIntro.astro';
import FeaturedPosts from '../components/FeaturedPosts.astro';
import { HOME_META_DESCRIPTION, HOME_PAGE_TITLE } from '../consts';
import { getPosts } from '../lib/notion';
import { getSlugFromTag } from '../lib/tag-slugs';
import { groupPostsBySeries } from '../lib/series';
import { resolveFeaturedPosts } from '../lib/featured-posts';

const posts = await getPosts();

// 日付整形用の関数
const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

// 0. 代表記事（「初めての方へ」）
// 取得経路は既存の getPosts() ひとつだけ。選定は slug の照合なので、
// 公開一覧に無い slug はここでリンクにならず、警告としてビルドログへ出る。
const featured = resolveFeaturedPosts(posts);
for (const warning of featured.warnings) console.warn(warning);

// 1. キーワード（タグ）の集計
const tagCounts = posts.reduce((acc, post) => {
  post.tags.forEach((tag: string) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const sortedTags = Object.entries(tagCounts)
  .sort(([, a], [, b]) => b - a);

// 2. シリーズ（カテゴリ）ごとに分類
// シリーズ名は記事側（Notion の Series / 「名前」プロパティ）から導出するため、
// 新しい「AIと◯◯」シリーズが増えてもこのファイルの変更は不要。
const postsBySeries = groupPostsBySeries(posts);

// 3. 月別アーカイブの作成
const postsByMonth = posts.reduce((acc, post) => {
  const date = new Date(post.date);
  const month = `${date.getFullYear()}年${date.getMonth() + 1}月`;
  if (!acc[month]) acc[month] = [];
  acc[month].push(post);
  return acc;
}, {} as Record<string, any[]>);
---

<!doctype html>
<html lang="ja">
  <head>
    <!--
      トップ専用の title / description を渡す。SITE_TITLE / SITE_DESCRIPTION の値は
      変えていないので、他ページの出力は従来どおり。og:title / og:description も
      BaseHead 内で同じ値を使うため、title / description / OGP は自動で揃う。
    -->
    <BaseHead title={HOME_PAGE_TITLE} description={HOME_META_DESCRIPTION} />
    <style>
      /* 基本設定：PCでは最大720px、スマホでは横幅いっぱいに広がる */
      main { 
        max-width: 720px; 
        margin: auto; 
        padding: 1rem; 
        width: 100%; /* 横幅がいっぱいにならないように追加 */
        box-sizing: border-box; /* パディングを含めた幅計算にする */
      }
      
      section { margin-bottom: 3rem; }
      
      h2 { 
        border-bottom: 1px solid var(--border); 
        padding-bottom: 0.5rem; 
        margin-top: 2rem; 
        display: flex; 
        align-items: center; 
        gap: 0.5rem;
        font-size: 1.5rem;
      }
      
      /* タグクラウドをスマホで折り返しやすくする */
      .tag-cloud { 
        display: flex; 
        flex-wrap: wrap; 
        gap: 0.5rem; 
        margin-top: 1rem; 
      }
      .tag-item { 
        text-decoration: none; 
        background: var(--bg-card); 
        border: 1px solid var(--border); 
        padding: 4px 12px; 
        border-radius: 20px; 
        font-size: 0.85rem; 
        color: var(--green-bright); 
        transition: all 0.2s;
        white-space: nowrap; /* タグの中で改行させない */
      }

      .archive-list { list-style: none; padding: 0; }
      .archive-item { 
        margin: 1.2rem 0; 
        padding-left: 1rem; 
        border-left: 3px solid var(--border);
        word-break: break-all; /* タイトルが長い場合に端で改行させる */
      }
      .archive-date { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.2rem; }
      .archive-link { font-weight: 500; text-decoration: none; color: var(--text); line-height: 1.4; }
      .archive-link:hover { color: var(--green-bright); text-decoration: underline; }
      /* 暗い配色では既定の focus ring が見えにくい。キーボード操作の現在地を必ず残す */
      .archive-link:focus-visible,
      .tag-item:focus-visible {
        outline: 2px solid var(--green-bright);
        outline-offset: 3px;
      }

      /* 【追加】スマートフォン用の微調整（画面幅600px以下） */
      @media (max-width: 600px) {
        h2 { font-size: 1.3rem; }
        main { padding: 0.8rem; } /* 余白を少し詰める */
        .archive-item { padding-left: 0.8rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <!-- 1. 主見出し・紹介文（h1 はこの中に 1 つだけ） -->
      <HomeIntro />

      <!-- 2. 初めての方へ：代表記事。解決できた記事が 0 件なら section ごと出ない -->
      <FeaturedPosts posts={featured.posts} />

      <!-- 3. シリーズ別（分類・並び順のロジックは groupPostsBySeries のまま） -->
      <section>
        <h2>シリーズ別</h2>
        {postsBySeries.map(s => (
          <div style="margin-bottom: 2rem;">
            <h3 style="font-size: 1.2rem; color: var(--text-muted); margin-bottom: 1rem;">{s.name}</h3>
            <ul class="archive-list">
              {s.posts.map(post => (
                <li class="archive-item">
                  <div class="archive-date">{formatDate(post.date)}</div>
                  <a href={`/posts/${post.slug || post.id}`} class="archive-link">{post.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <!-- 4. キーワード集 -->
      <section>
        <h2>キーワード集</h2>
        <p style="font-size: 0.9rem; color: var(--text-muted);">よく触れられている思索のテーマ</p>
        <div class="tag-cloud">
          {sortedTags.map(([tag, count]) => (
            <a href={`/tags/${getSlugFromTag(tag)}`} class="tag-item">
              {tag} <span class="tag-count">({count})</span>
            </a>
          ))}
        </div>
      </section>

      <!-- 5. 月別 -->
      <section>
        <h2>月別</h2>
        {Object.keys(postsByMonth).sort().reverse().map(month => (
          <div style="margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.1rem; color: var(--text-muted); border-left: 4px solid var(--border); padding-left: 10px;">{month}</h3>
            <ul class="archive-list">
              {postsByMonth[month].map(post => (
                <li class="archive-item">
                  <div class="archive-date">{formatDate(post.date)}</div>
                  <a href={`/posts/${post.slug || post.id}`} class="archive-link">{post.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    </main>
    <Footer />
  </body>
</html>
