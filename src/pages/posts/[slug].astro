---
import { getPostBySlug } from '../../lib/notion';
import { getSlugFromTag } from '../../lib/tag-slugs';
import { marked } from 'marked';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const { slug } = Astro.params;

// 記事が無ければ 404。以前は取得失敗も「本文がありません。」として 200 を返していた
const post = await getPostBySlug(slug as string);
if (!post) return new Response('Not found', { status: 404 });

// 本文の変換は Phase 4 でフォーマット層に置き換える
const htmlContent = marked(post.content);
const { title, tags, heroImage } = post;
---

<html lang="ja">
  <head>
    <BaseHead title={title} description="" />
    <style>
      /* メインコンテナ：スマホでの「横切れ」を防止 */
      main { 
        width: 100%; 
        max-width: 720px; 
        margin: 0 auto; 
        padding: 1rem; 
        box-sizing: border-box; /* パディングを幅に含める */
      }

      /* タイトル：長いタイトルが画面を突き破らないようにする */
      h1 {
        font-size: 2rem;
        line-height: 1.3;
        margin-bottom: 0.5rem;
        word-wrap: break-word; /* 長い単語を途中で改行 */
        overflow-wrap: break-word;
      }

      /* Notion本文の調整 */
      .notion-content { 
        line-height: 1.8; 
        margin-top: 2rem; 
        font-size: 1.05rem;
        word-break: break-word; /* 本文の改行ルール */
      }
      
      /* 本文内の画像やコードブロックがはみ出さないように */
      .notion-content :global(img),
      .notion-content :global(video),
      .notion-content :global(pre) {
        max-width: 100%;
        height: auto;
      }

      .tags-container { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
      .tag-badge { background: var(--bg-card); padding: 3px 10px; border-radius: 12px; font-size: 0.8rem; color: var(--green-bright); text-decoration: none; border: 1px solid var(--border); }
      
      /* アイキャッチ画像：アスペクト比を保ちつつスマホに最適化 */
      .hero-image { 
        width: 100%; 
        height: auto;
        max-height: 450px; 
        object-fit: cover; 
        border-radius: 12px; 
        margin: 1.5rem 0; 
        box-shadow: 0 4px 16px rgba(0,0,0,0.4); 
      }

      /* 【追加】スマホ用の微調整（画面幅600px以下） */
      @media (max-width: 600px) {
        h1 { font-size: 1.6rem; }
        main { padding: 0.8rem; }
        .notion-content { font-size: 1rem; } /* スマホでは少し文字を小さくして読みやすく */
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <article>
        <h1 style="margin-bottom: 0.5rem;">{title}</h1>
        
        {/* 1. タイトル直下に画像を表示 */}
        {heroImage && (
          <img src={heroImage} alt={title} class="hero-image" />
        )}

        {/* 2. タグをクリック可能に修正 */}
        {tags.length > 0 && (
          <div class="tags-container">
            {tags.map((tag: string) => (
              <a href={`/tags/${getSlugFromTag(tag)}`} class="tag-badge">{tag}</a>
            ))}
          </div>
        )}

        <hr />
        <div class="notion-content" set:html={htmlContent}></div>
      </article>
    </main>
    <Footer />
  </body>
</html>