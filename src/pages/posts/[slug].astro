---
import { getPosts } from '../../lib/notion';
import type { Post } from '../../lib/types';
import { assertArticleDocumentRenderable } from '../../lib/article-document';
import { articleDescription } from '../../lib/article-metadata';
import { getSeriesName } from '../../lib/series';
import ArticleContent from '../../components/article/ArticleContent.astro';
import LegacyArticleContent from '../../components/article/LegacyArticleContent.astro';
import ArticleShell from '../../components/article/ArticleShell.astro';

// 記事ページはビルド時に全件生成する。
// 記事を props で渡すので、ページごとに Notion を引き直さない（1ビルド 1クエリ）。
// ここに無い slug は静的ファイルが存在しないので、そのまま 404 になる。
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: Post };

const { post } = Astro.props;

// 本文の正本は contentSource。文字列だけでは legacy Content と Notion の
// ページ本文を区別できないので、必ずここで分岐する。
//
// legacy   … 既存記事。marked + set:html（従来どおり）
// notion-page … 移行済み記事。型付き ArticleDocument をコンポーネントで描く
//
// **安全性をこのページに依存させないこと。** ページ本文の URL と画像の不変条件は
// lib/notion.ts の applyPageBodyInvariants が取得の段で当てており、違反があれば
// ここを通る前にビルドが落ちる（Issue #6）。
const source = post.contentSource;

// 将来 ArticleBlock に描画未対応の種別が増えていないか、
// 描画に入る前に記事単位で落とす。コンポーネント側でも弾くが、ここで出す方が
// どの記事かが分かる
if (source.kind === 'notion-page') {
  assertArticleDocumentRenderable(source.document, { slug: post.slug });
}

const description = articleDescription(post);
const seriesName = getSeriesName(post);
---

<ArticleShell
  title={post.title}
  description={description}
  pubDate={post.date}
  seriesName={seriesName}
  tags={post.tags}
  heroImage={post.heroImage}
>
  {source.kind === 'legacy' ? (
    <LegacyArticleContent content={source.content} />
  ) : (
    <ArticleContent document={source.document} />
  )}
</ArticleShell>
