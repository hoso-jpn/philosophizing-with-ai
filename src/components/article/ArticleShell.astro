---
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import ArticleHeader from './ArticleHeader.astro';

interface Props {
  title: string;
  description: string;
  pubDate: string;
  seriesName?: string | null;
  tags?: string[];
  heroImage?: string | null;
}

const props = Astro.props as Props;
const hasAfterContent = Astro.slots.has('after-content');
---
<html lang="ja">
  <head><BaseHead title={props.title} description={props.description} /></head>
  <body>
    <Header />
    <main class="article-main">
      <article>
        <ArticleHeader
          title={props.title}
          pubDate={props.pubDate}
          seriesName={props.seriesName}
          tags={props.tags}
          heroImage={props.heroImage}
        />
        <hr />
        <div class="article-body"><slot /></div>
        {hasAfterContent && <footer class="article-footer"><slot name="after-content" /></footer>}
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .article-main {
    box-sizing: border-box;
    width: min(100%, 752px);
    max-width: none;
    margin: 0 auto;
    padding: 3rem 1rem;
  }
  .article-body { min-width: 0; overflow-wrap: break-word; }
  .article-body :global(.notion-content),
  .article-body :global(.article-content) {
    margin-top: 0;
    font-size: 1.05rem;
    line-height: 1.85;
    word-break: break-word;
  }
  .article-body :global(img),
  .article-body :global(video),
  .article-body :global(pre),
  .article-body :global(table) { max-width: 100%; }
  .article-footer { margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 2rem; }
  @media (max-width: 600px) {
    .article-main { padding: 1.25rem 0.8rem; }
    .article-body :global(.notion-content),
    .article-body :global(.article-content) { font-size: 1rem; }
  }
</style>
