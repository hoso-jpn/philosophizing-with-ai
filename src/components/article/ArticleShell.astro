---
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import ArticleHeader from './ArticleHeader.astro';

interface Props {
  title: string;
  description: string;
  pubDate: string;
  seriesName?: string | null;
  tags?: string[];
  heroImage?: string | null;
}

const props = Astro.props as Props;

/**
 * 記事後 slot は **描画結果で** 判定する。
 *
 * `Astro.slots.has('after-content')` は slot 名がテンプレートに書かれていれば
 * true を返す。`{cond && <Fragment slot="after-content">…</Fragment>}` のように
 * 条件付きで渡す呼び出し側では、cond が false でも true になる（実測）。
 * これを信じると、中身が無いのに `<footer class="article-footer">` だけが出て、
 * border-top と上下 5rem の余白が記事末尾に線として残る。
 *
 * 描画済みの文字列を見れば「本当に中身があるか」で判定できる。set:html へ渡す
 * のは Astro が描画した slot の出力そのもので、外部入力ではない。
 */
const afterContent = Astro.slots.has('after-content')
  ? await Astro.slots.render('after-content')
  : '';
const hasAfterContent = afterContent.trim() !== '';
---
<html lang="ja">
  <head><BaseHead title={props.title} description={props.description} /></head>
  <body>
    <Header />
    <main class="article-main">
      <article>
        <ArticleHeader
          title={props.title}
          pubDate={props.pubDate}
          seriesName={props.seriesName}
          tags={props.tags}
          heroImage={props.heroImage}
        />
        <hr />
        <div class="article-body"><slot /></div>
        {hasAfterContent && <footer class="article-footer" set:html={afterContent} />}
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .article-main {
    box-sizing: border-box;
    width: min(100%, 752px);
    max-width: none;
    margin: 0 auto;
    padding: 3rem 1rem;
  }
  .article-body { min-width: 0; overflow-wrap: break-word; }
  .article-body :global(.notion-content),
  .article-body :global(.article-content) {
    margin-top: 0;
    font-size: 1.05rem;
    line-height: 1.85;
    word-break: break-word;
  }
  .article-body :global(img),
  .article-body :global(video),
  .article-body :global(pre),
  .article-body :global(table) { max-width: 100%; }

  /**
   * 記事全体の横 overflow はこの shell が受け持つ。
   *
   * 表・display 数式・コードは自前の scroll container を持つが、**インライン数式
   * だけは持たない**。ArticleMath は式の途中で折り返さないよう
   * `white-space: nowrap` を当てており、上位に幅の制限が無いと本文の外へ出る。
   * 360px 幅の端末では `y_{ij} = \mu + a_i + b_j + e_{ij}` 程度で既に超えるため、
   * 記事 1 本ぶんの横スクロールが出てしまう。
   *
   * 切り取る（overflow: hidden）と式が読めなくなるので、その式だけを
   * スクロールさせる。ベースラインが崩れないよう vertical-align を添える。
   */
  .article-body :global(.article-math--inline) {
    display: inline-block;
    max-width: 100%;
    overflow-x: auto;
    vertical-align: bottom;
  }
  .article-footer { margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 2rem; }
  @media (max-width: 600px) {
    .article-main { padding: 1.25rem 0.8rem; }
    .article-body :global(.notion-content),
    .article-body :global(.article-content) { font-size: 1rem; }
  }
</style>
