---
/**
 * コードブロック。
 *
 * シンタックスハイライトは本文を読むための必須条件ではないので入れない。
 * 言語は正規化した class と data 属性に残し、後から highlighter を足せるようにする。
 */
import type { ArticleBlock } from '../../lib/article-document';
import { codeLanguageClass } from '../../lib/article-code';
import ArticleRichText from './ArticleRichText.astro';

interface Props {
  block: Extract<ArticleBlock, { kind: 'code' }>;
}
const { block } = Astro.props as Props;
const languageClass = codeLanguageClass(block.language);
---
<figure class="article-code">
  <pre><code class={languageClass} data-language={block.language}>{block.code}</code></pre>
  {block.caption.length > 0 && (
    <figcaption><ArticleRichText nodes={block.caption} blockId={block.id} /></figcaption>
  )}
</figure>

<style>
  .article-code { margin: 1.5em 0; }
  .article-code figcaption {
    margin-top: 0.5em;
    font-size: 0.85em;
    color: var(--text-muted);
  }
</style>
