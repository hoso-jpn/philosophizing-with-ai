---
/**
 * Notion ページ本文の入口。
 *
 * 受け取るのは ArticleDocument であって Notion の生ブロックではない。
 * 正規化は lib/notion-normalize.ts が取得の段で済ませてある。
 */
import type { ArticleDocument } from '../../lib/article-document';
import ArticleBlocks from './ArticleBlocks.astro';
import 'katex/dist/katex.min.css';

interface Props {
  document: ArticleDocument;
}
const { document } = Astro.props as Props;
---
<div class="article-content">
  <ArticleBlocks blocks={document.blocks} />
</div>

<style>
  /* 既存の記事タイポグラフィに合わせる。global.css が p / blockquote / code /
     pre / hr / a の見た目を持っているので、ここは間隔と字下げだけを補う */
  .article-content { line-height: 1.8; font-size: 1.05rem; word-break: break-word; }

  .article-content :global(h2) { margin: 2em 0 0.6em; font-size: 1.5rem; line-height: 1.4; }
  .article-content :global(h3) { margin: 1.8em 0 0.5em; font-size: 1.25rem; line-height: 1.4; }
  .article-content :global(h4) { margin: 1.6em 0 0.5em; font-size: 1.1rem; line-height: 1.4; }

  .article-content :global(ul),
  .article-content :global(ol) { margin: 0 0 1em; padding-left: 1.5em; }
  .article-content :global(li) { margin-bottom: 0.4em; }
  /* 入れ子のリストは上下の余白を詰める（親の項目とくっつけて読ませる） */
  .article-content :global(li > ul),
  .article-content :global(li > ol) { margin: 0.4em 0 0; }

  .article-content :global(pre) { max-width: 100%; }
  .article-content :global(pre code) { white-space: pre; }
  .article-content :global(img) { max-width: 100%; height: auto; }

  @media (max-width: 600px) {
    .article-content { font-size: 1rem; }
    .article-content :global(h2) { font-size: 1.3rem; }
    .article-content :global(h3) { font-size: 1.15rem; }
  }
</style>
