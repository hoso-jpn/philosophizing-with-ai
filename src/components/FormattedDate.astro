---
/**
 * サイト全体の日付表示をここに集約する。
 * 以前は /tags/[slug] だけが整形せず生の ISO 文字列を出していた。
 */
interface Props {
	date: Date | string;
}

const { date } = Astro.props;
const value = date instanceof Date ? date : new Date(date);
---

<time datetime={value.toISOString()}>
	{
		value.toLocaleDateString('ja-JP', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		})
	}
</time>
