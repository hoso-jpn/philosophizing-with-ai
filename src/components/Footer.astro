---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<span class="copy">© {today.getFullYear()} Philosophizing with AI</span>
		<a href="https://florigen.ai" target="_blank" rel="noreferrer" class="footer-link">Florigen AI</a>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		margin-top: 5em;
		padding: 2.5em 1.5em 4em;
	}
	.footer-inner {
		max-width: 900px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1em;
	}
	.copy {
		font-size: 12px;
		font-family: var(--font-mono);
		letter-spacing: 0.05em;
		color: var(--text-muted);
	}
	.footer-link {
		font-size: 12px;
		font-family: var(--font-mono);
		letter-spacing: 0.1em;
		color: var(--green-light);
		text-decoration: none;
	}
	.footer-link:hover {
		color: var(--green-bright);
	}
	@media (max-width: 640px) {
		.footer-inner {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
