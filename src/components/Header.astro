---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="brand">
			<img src="/favicon.svg" alt="" class="brand-mark" width="20" height="20" />
			<span class="brand-name">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<a href="https://florigen.ai" target="_blank" rel="noreferrer" class="parent-link">
			florigen.ai ↗
		</a>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 1.5em;
		background: rgba(10, 15, 10, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 900px;
		margin: 0 auto;
		height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}
	.brand-mark {
		display: block;
		border-radius: 4px;
	}
	.brand-name {
		font-size: 13px;
		letter-spacing: 0.1em;
		color: var(--text);
		font-weight: 500;
	}
	.internal-links {
		display: flex;
		gap: 8px;
	}
	.internal-links :global(a) {
		color: var(--text-muted);
		font-size: 13px;
		padding: 8px 12px;
		text-decoration: none;
		border-radius: 2px;
		transition: color 0.15s;
	}
	.internal-links :global(a:hover) {
		color: var(--text);
	}
	.internal-links :global(a.active) {
		color: var(--green-bright);
		font-weight: 500;
	}
	.parent-link {
		font-size: 11px;
		font-family: var(--font-mono);
		letter-spacing: 0.1em;
		color: var(--text-muted);
		text-decoration: none;
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 6px 12px;
		white-space: nowrap;
	}
	.parent-link:hover {
		color: var(--green-bright);
		border-color: var(--green);
	}
	@media (max-width: 640px) {
		nav {
			padding: 0;
		}
		.brand-name {
			display: none;
		}
		.parent-link {
			display: none;
		}
	}
</style>
